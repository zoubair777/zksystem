# مفتاح جلسات Flask
ERP_SECRET_KEY=ضع-مفتاحًا-عشوائيًا-طويلًا

# النسخ الاحتياطي: الربط بـ Google Drive يتم من صفحة "النسخ الاحتياطي" داخل البرنامج (لا مفاتيح هنا).
# كل كم دقيقة تُؤخذ نسخة محلية على الجهاز (الافتراضي 60)
BACKUP_INTERVAL_MINUTES=60

